{
  "name": "whitebox-hub",
  "version": "0.1.0",
  "description": "whitebox-js hub: declarative entries that pair a method with dataset collections, controls and render views, and the generated catalogue the hub app is built from.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njtwomey/whitebox-js.git",
    "directory": "packages/hub"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "whitebox-engine": "workspace:*",
    "whitebox-render": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
}
