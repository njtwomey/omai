{
  "name": "whitebox-meta",
  "version": "0.1.0",
  "description": "whitebox-js documentation metadata: schema, docstring extractor, example runner, worker and concepts.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njtwomey/whitebox-js.git",
    "directory": "packages/meta"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "whitebox-engine": "workspace:*",
    "whitebox-render": "workspace:*",
    "whitebox-hub": "workspace:*"
  }
}
