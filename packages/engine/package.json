{
  "name": "omai-engine",
  "version": "0.1.12",
  "description": "omai compute: tensors, autodiff, numerics, probability, learning, neural networks, RL and datasets, all traced.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njtwomey/omai.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "index",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts"
  ],
  "exports": {
    "./*": {
      "source": "./src/lib/*/index.ts",
      "types": "./dist/lib/*/index.d.ts",
      "import": "./dist/lib/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
