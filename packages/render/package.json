{
  "name": "omai-render",
  "version": "0.1.4",
  "description": "omai figures: ECharts options, layouts, scene and structure drawing, SVG and animation export; React bindings.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/njtwomey/omai.git",
    "directory": "packages/render"
  },
  "files": [
    "dist",
    "src",
    "llms.txt",
    "index",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/_fake.ts",
    "!src/**/_harness.tsx"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "katex": "0.16.47",
    "omai-engine": "workspace:*"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
