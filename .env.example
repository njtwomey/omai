# Shared environment for whitebox-js (Python scripts read it through pydantic-settings, Vite through envDir).
# Only VITE_-prefixed keys reach the browser: never put secrets under that prefix.

# Port for `make dev-docs` (apps/docs).
VITE_DOCS_PORT=5180
# Port for `make dev-gallery` (apps/gallery).
VITE_GALLERY_PORT=5181
# GitHub repository that hosts release tarballs and large dataset assets (owner/name).
WHITEBOX_REPOSITORY=njtwomey/whitebox-js
# Where Python scripts write golden fixtures.
WHITEBOX_FIXTURES_DIR=packages/engine/fixtures
