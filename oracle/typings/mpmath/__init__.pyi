# mpmath ships no type stubs or py.typed marker. This stub types the part of mpmath the oracle uses, so pyright strict
# checks mpmath arithmetic as `mpf` values. Add a declaration here when a case module needs another function.
from collections.abc import Callable, Sequence
from contextlib import AbstractContextManager

__version__: str

type Num = mpf | float | int

class mpf:
    def __init__(self, x: Num | str = 0) -> None: ...
    def __add__(self, other: Num) -> mpf: ...
    def __radd__(self, other: Num) -> mpf: ...
    def __sub__(self, other: Num) -> mpf: ...
    def __rsub__(self, other: Num) -> mpf: ...
    def __mul__(self, other: Num) -> mpf: ...
    def __rmul__(self, other: Num) -> mpf: ...
    def __truediv__(self, other: Num) -> mpf: ...
    def __rtruediv__(self, other: Num) -> mpf: ...
    def __pow__(self, other: Num) -> mpf: ...
    def __rpow__(self, other: Num) -> mpf: ...
    def __neg__(self) -> mpf: ...
    def __pos__(self) -> mpf: ...
    def __abs__(self) -> mpf: ...
    def __lt__(self, other: Num) -> bool: ...
    def __le__(self, other: Num) -> bool: ...
    def __gt__(self, other: Num) -> bool: ...
    def __ge__(self, other: Num) -> bool: ...
    def __float__(self) -> float: ...
    def __int__(self) -> int: ...

class _Context:
    dps: int
    prec: int

mp: _Context
pi: mpf
inf: mpf

def workdps(n: int) -> AbstractContextManager[None]: ...
def diff(f: Callable[[mpf], Num], x: Num, n: int = 1) -> mpf: ...
def quad(f: Callable[[mpf], Num], interval: Sequence[Num]) -> mpf: ...
def nsum(f: Callable[[mpf], Num], interval: Sequence[Num]) -> mpf: ...

# Elementary functions.
def sqrt(x: Num) -> mpf: ...
def exp(x: Num) -> mpf: ...
def log(x: Num) -> mpf: ...
def log1p(x: Num) -> mpf: ...
def asin(x: Num) -> mpf: ...

# Error functions and the normal distribution.
def erf(x: Num) -> mpf: ...
def erfc(x: Num) -> mpf: ...
def erfi(x: Num) -> mpf: ...
def erfinv(x: Num) -> mpf: ...
def ncdf(x: Num, mu: Num = 0, sigma: Num = 1) -> mpf: ...
def npdf(x: Num, mu: Num = 0, sigma: Num = 1) -> mpf: ...

# Gamma family and incomplete functions.
def gamma(x: Num) -> mpf: ...
def rgamma(x: Num) -> mpf: ...
def loggamma(x: Num) -> mpf: ...
def digamma(x: Num) -> mpf: ...
def polygamma(n: int, x: Num) -> mpf: ...
def beta(a: Num, b: Num) -> mpf: ...
def binomial(n: Num, k: Num) -> mpf: ...
def gammainc(z: Num, a: Num = 0, b: Num = ..., regularized: bool = False) -> mpf: ...
def betainc(a: Num, b: Num, x1: Num = 0, x2: Num = 1, regularized: bool = False) -> mpf: ...

# Zeta, exponential integrals, Lambert W, sine, cosine and Fresnel integrals.
def zeta(s: Num, a: Num = 1) -> mpf: ...
def lambertw(z: Num, k: int = 0) -> mpf: ...
def expint(n: Num, z: Num) -> mpf: ...
def ei(x: Num) -> mpf: ...
def si(x: Num) -> mpf: ...
def ci(x: Num) -> mpf: ...
def fresnels(x: Num) -> mpf: ...
def fresnelc(x: Num) -> mpf: ...

# Bessel functions.
def besseli(n: Num, x: Num) -> mpf: ...
def besselk(n: Num, x: Num) -> mpf: ...
def besselj(n: Num, x: Num) -> mpf: ...
def bessely(n: Num, x: Num) -> mpf: ...

# Elliptic integrals and functions (ellipe takes m, or phi and m).
def ellipk(m: Num) -> mpf: ...
def ellipe(*args: Num) -> mpf: ...
def ellipf(phi: Num, m: Num) -> mpf: ...
def ellipfun(kind: str, u: Num, m: Num) -> mpf: ...
